# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel -> Project -> Settings -> Environment Variables for production.
#
# NOTHING in this file may ever be committed or shipped inside the desktop app.

# Supabase -> Project Settings -> Data API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> "Secret keys" -> sb_secret_...
# Bypasses row-level security. Server-side only, never in the client.
#
# This replaces the old `service_role` JWT, which Supabase deprecates at the
# end of 2026. If you are still on the legacy key, SUPABASE_SERVICE_ROLE_KEY
# is read as a fallback -- but migrate before then or the server will break.
SUPABASE_SECRET_KEY=sb_secret_...

# Ed25519 PKCS#8 private key from `node scripts/generate-license-keypair.mjs`
# (repo root). Paste the whole PEM including BEGIN/END lines. Literal "\n"
# sequences are also accepted if your shell mangles real newlines.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAw...\n-----END PRIVATE KEY-----\n"

# Long random string guarding /api/release. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
