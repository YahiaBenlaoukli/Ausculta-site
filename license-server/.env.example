# Copy to .env.local for `vercel dev` and the admin scripts, and set the same
# names in Vercel -> Project -> Settings -> Environment Variables.
#
# NOTHING in this file may ever be committed or shipped inside the desktop app.

# ─── Licence server (required) ──────────────────────────────────────────

# Supabase -> Project Settings -> Data API. The bare project URL; a trailing
# /rest/v1/ is trimmed automatically if you paste the REST endpoint instead.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> "Secret keys" -> sb_secret_...
# Bypasses row-level security. Server-side only, never in the client.
#
# Replaces the old `service_role` JWT, which Supabase deprecates at the end of
# 2026. SUPABASE_SERVICE_ROLE_KEY is still read as a fallback -- but migrate
# before then or activation breaks.
SUPABASE_SECRET_KEY=sb_secret_...

# Ed25519 PKCS#8 private key from `node scripts/generate-license-keypair.mjs`.
# .env files cannot hold real newlines, so use the \n-escaped single-line form.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAw...\n-----END PRIVATE KEY-----\n"

# Long random string guarding /api/release. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ─── App updates (Cloudflare R2) ────────────────────────────────────────
# Only needed for /api/updates and scripts/publish-release.mjs. The licence
# server runs fine without these; /api/health reports "updates": false.
#
# Cloudflare dashboard -> R2 -> Manage API tokens -> create a token with
# "Object Read & Write". Keep every bucket PRIVATE: downloads are served
# through short-lived signed URLs, never public object access.
#
# ONE BUCKET PER PRODUCT. The unsuffixed names below are Ausculta's, because
# they were the only ones before Dentura existed. Any of them can be overridden
# per product with a _<PRODUCT> suffix; anything not overridden is inherited.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ausculta

# Dentura's bucket. This one is REQUIRED to publish or serve Dentura updates --
# it has no fallback, deliberately: inheriting Ausculta's bucket would publish
# the dental app over Ausculta's latest.yml and offer it to medical clinics as
# an update.
R2_BUCKET_DENTURA=

# Only if Dentura's bucket lives in a different Cloudflare account, or its API
# token is scoped so it cannot see Ausculta's bucket. Leave these blank when
# one account and one token cover both -- the values above are then inherited.
# R2_ACCOUNT_ID_DENTURA=
# R2_ACCESS_KEY_ID_DENTURA=
# R2_SECRET_ACCESS_KEY_DENTURA=
